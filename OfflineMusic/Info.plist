<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Offline Music</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>OfflineMusic</string>
    <key>UILaunchScreen</key><dict/>
    <key>UIBackgroundModes</key><array><string>audio</string></array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Offline Music sucht deinen Mac im Heimnetz und verbindet sich sicher mit deinem lokalen Musik-Companion.</string>
    <key>NSBonjourServices</key><array><string>_offlinemusic._tcp</string></array>
    <key>NSCameraUsageDescription</key>
    <string>Scanne den Kopplungs-QR-Code im Terminal deines Macs, um die sichere Companion-Verbindung einzurichten.</string>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
