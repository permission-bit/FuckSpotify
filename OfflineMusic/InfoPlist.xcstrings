    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Kopplungs-QR-Code auf deinem Mac, um die sichere Companion-Verbindung einzurichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the pairing QR code on your Mac to set up a secure Companion connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código QR de emparejamiento en tu Mac para establecer una conexión segura con Companion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code QR de jumelage affiché sur votre Mac pour établir une connexion sécurisée avec Companion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice QR di abbinamento sul Mac per configurare una connessione sicura con Companion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macに表示されたペアリング用QRコードをスキャンして、Companionとの安全な接続を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 표시된 페어링 QR 코드를 스캔하여 Companion에 안전하게 연결합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de QR-code op je Mac om een veilige koppeling met Companion in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod QR parowania na Macu, aby skonfigurować bezpieczne połączenie z aplikacją Companion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código QR de pareamento no Mac para configurar uma conexão segura com o Companion."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli bir Companion bağlantısı kurmak için Mac’indeki eşleme QR kodunu tara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描 Mac 上的配对二维码，与 Companion 建立安全连接。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox findet deinen Mac im Heimnetz und verbindet sich sicher mit deinem lokalen Musik-Companion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox finds your Mac on the home network and securely connects to your local music Companion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox busca tu Mac en la red doméstica y se conecta de forma segura al Companion musical local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox trouve votre Mac sur le réseau domestique et se connecte de manière sécurisée au Companion musical local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox trova il tuo Mac nella rete domestica e si connette in modo sicuro al Companion musicale locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "joxはホームネットワーク上のMacを見つけ、ローカルの音楽用Companionに安全に接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox는 홈 네트워크에서 Mac을 찾고 로컬 음악 Companion에 안전하게 연결합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox vindt je Mac op je thuisnetwerk en maakt veilig verbinding met je lokale muziekcompanion."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox znajduje Maca w sieci domowej i bezpiecznie łączy się z lokalną aplikacją Companion do obsługi muzyki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jox encontra seu Mac na rede doméstica e se conecta com segurança ao Companion de música local."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox, Mac’ini ev ağında bulur ve yerel müzik Companion uygulamasına güvenli şekilde bağlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jox 会在家庭网络中查找你的 Mac，并安全连接到本地音乐 Companion。"
          }
        }
      }
    }
  },
  "version" : "1.0"
