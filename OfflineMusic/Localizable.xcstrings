          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het volume neemt af in de laatste 5 seconden. De timer loopt door als het afspelen is gepauzeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośność spada w ostatnich 5 sekundach. Minutnik odlicza również podczas przerwy w odtwarzaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O volume diminui nos últimos 5 segundos. O timer continua contando mesmo quando a reprodução está pausada."
