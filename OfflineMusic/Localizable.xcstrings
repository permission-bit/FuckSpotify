    "Blendet aufeinanderfolgende Titel ineinander. Bei kurzen Titeln wird die Überblendung automatisch verkürzt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fades consecutive tracks into each other. The crossfade is automatically shortened for short tracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pistas se inclinan consecutivas entre sí. La pistas cruzadas se abrevia automáticamente por pistas cortas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fades traquent les uns les autres en conséquence. La croisière est automatiquement raccourcée pour des traces courtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tracce successive si muovono l'una all'altra. la trappola è automaticamente tagliata per tracce brevi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フードは連続でトラックを互いに結びつける。 クロスフードは自動的に短いトラックに短縮されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그들은 서로를 연속적으로 흔들리게 한다. 교차점은 자동으로 짧은 트랙으로 단축됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fades tracks consecutive in elkaar. de crossfade wordt automatisch gesneden voor korte tracks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżki kolejowe wchodzą do siebie nawzajem. Ścieżka krzyżowa jest automatycznie skrócona na krótkie ścieżki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As faixas seguem as faixas entre si. A faixa cruzada é automaticamente cortada para faixas curtas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aralıksız çizgiler birbirine girer. çapraz çizgiler otomatik olarak kısa çizgiler için kısaltılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fades 连续跟踪到彼此. 十字路口自动缩短为短轨道。"
          }
        }
      }
    },
