    "Erlaube jox den Kamerazugriff in den iPhone-Einstellungen. Auch eine Bildschirmzeit-Beschränkung kann die Kamera sperren." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow jox to access the camera in iPhone Settings. A Screen Time restriction may also block the camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a jox acceder a la cámara en los ajustes del iPhone. Una restricción de Tiempo de uso también puede bloquearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez jox à accéder à l’appareil photo dans les réglages de l’iPhone. Une restriction de Temps d’écran peut également le bloquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a jox di accedere alla fotocamera nelle impostazioni di iPhone. Anche una restrizione di Tempo di utilizzo può bloccarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の設定で jox のカメラへのアクセスを許可してください。スクリーンタイムの制限でカメラがブロックされる場合もあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 설정에서 jox가 카메라에 접근할 수 있도록 허용하세요. 스크린 타임 제한으로도 카메라가 차단될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef jox toegang tot de camera in de iPhone-instellingen. Een beperking in Schermtijd kan de camera ook blokkeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól aplikacji jox na dostęp do aparatu w ustawieniach iPhone’a. Ograniczenie Czasu przed ekranem także może blokować aparat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o jox acesse a câmera nos ajustes do iPhone. Uma restrição do Tempo de Uso também pode bloquear a câmera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ayarlarında jox’a kamera erişimi ver. Ekran Süresi sınırlaması da kamerayı engelleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iPhone 设置中允许 jox 访问相机。屏幕使用时间的限制也可能阻止使用相机。"
          }
        }
      }
    },
    "Erlaube Offline Music den Kamerazugriff in den iPhone-Einstellungen. Auch eine Bildschirmzeit-Beschränkung kann die Kamera sperren." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Offline Music to access the camera in iPhone Settings. Screen Time restrictions can also block the camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la música fuera de línea acceda a la cámara en la configuración de iPhone. Las restricciones de tiempo de pantalla también pueden bloquear la cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettez à la musique hors ligne d'accéder à la caméra dans les paramètres de l'iPhone. Les restrictions de temps d'écran peuvent également bloquer la caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettere la musica offline di accedere alla fotocamera nelle impostazioni di iPhone. Le restrizioni del tempo dello schermo possono anche bloccare la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン音楽がiPhoneの設定でカメラにアクセスできるようにします。スクリーンタイム制限もカメラをブロックすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 설정에서 오프라인 음악이 카메라에 액세스할 수 있도록 허용합니다.스크린 타임 제한은 또한 카메라를 차단할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
