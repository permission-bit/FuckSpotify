            "state" : "translated",
            "value" : "Müziğiniz"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的音乐"
          }
        }
      }
    },
    "Deine Playlists" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your playlists"
          }
        }
      }
    },
    "Der gerade spielende Titel läuft weiter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current song will keep playing."
          }
        }
      }
    },
    "Der gespeicherte Importstatus kann nicht gelesen werden. Es werden keine Dateien automatisch erneut importiert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved import status could not be read. No files will be automatically imported again."
          }
        }
      }
    },
    "Der Mac verarbeitet den Auftrag noch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Mac is still processing the job."
          }
        }
      }
    },
    "Der Mac-Dienst meldet einen Fehler (HTTP %@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac service reported an error (HTTP %@)."
          }
        }
      }
    },
    "Der Mac-Dienst meldet einen Fehler (HTTP %lld)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac service reported an error (HTTP %lld)."
          }
        }
      }
    },
    "Der SHA-256-Fingerabdruck muss aus 64 Hexadezimalzeichen bestehen. Übernimm ihn direkt vom Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SHA-256 fingerprint must contain 64 hexadecimal characters. Copy it directly from your Mac."
          }
        }
      }
    },
    "Der Vorgang konnte nicht abgeschlossen werden. Bitte versuche es erneut." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The operation could not be completed. Please try again."
          }
        }
      }
    },
    "Der Zugang ist ungültig oder widerrufen. Bei der Erstkopplung kann auch der Einmalcode abgelaufen oder verbraucht sein." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access is invalid or revoked. During initial pairing, the one-time code may also have expired or already been used."
          }
        }
      }
    },
    "Der Zugang konnte nicht sicher im Schlüsselbund gelesen oder gespeichert werden. Entsperre das iPhone und versuche es erneut." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access credentials could not be securely read from or saved to the Keychain. Unlock your iPhone and try again."
          }
        }
      }
    },
    "Deutsch und Englisch sind vollständig übersetzt. Weitere Sprachen sind teilweise übersetzt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "German and English are fully translated. Other languages are partially translated."
          }
        }
      }
    },
    "Die Antwort passt nicht zum Companion-Protokoll. Prüfe die Version des Mac-Dienstes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The response does not match the Companion protocol. Check the Mac service version."
          }
        }
      }
    },
    "Die App übernimmt fertige MP3-Dateien im Vordergrund. Bei Unterbrechungen setzt sie den Import beim nächsten Öffnen fort. Geprüfte Downloads und Importzuordnungen bleiben erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app imports ready MP3 files while in the foreground. If interrupted, the import resumes the next time you open the app. Verified downloads and import assignments are preserved."
          }
        }
      }
    },
    "Die Audiodateien bleiben in deiner Bibliothek erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio files will remain in your library."
          }
        }
      }
    },
    "Die ausgewählten Playlists und ihre Verknüpfungen werden entfernt. Songs und Audiodateien bleiben erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected playlists and their song links will be removed. Songs and audio files will be kept."
          }
        }
      }
    },
    "Die ausgewählten Titel werden aus der Bibliothek entfernt. Audiodateien bleiben erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected songs will be removed from the library. Audio files will be kept."
          }
        }
      }
    },
    "Die Datei ist unvollständig oder beschädigt. Größe, Prüfsumme oder Audioformat stimmen nicht." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is incomplete or damaged. Its size, checksum or audio format does not match."
          }
        }
      }
    },
    "Die Dateiangaben des Macs sind ungültig oder haben sich geändert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac's file information is invalid or has changed."
          }
        }
      }
    },
    "Die ersten 1.000 Listeneinträge sind geladen. Öffne längere Playlists direkt auf YouTube." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first 1,000 entries have been loaded. Open longer playlists directly on YouTube."
          }
        }
      }
    },
    "Die Kamera ist momentan nicht verfügbar. Öffne den Scanner erneut oder füge die Kopplungsdaten manuell ein." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is currently unavailable. Open the scanner again or paste the pairing data manually."
          }
        }
      }
    },
    "Die Kamera konnte nicht gestartet werden. Schließe andere Kamera-Apps und versuche es erneut." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera could not be started. Close other camera apps and try again."
          }
        }
      }
    },
    "Die Kopplungsdaten sind abgelaufen. Erzeuge auf dem Mac einen neuen Code." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pairing data has expired. Generate a new code on the Mac."
          }
        }
      }
    },
    "Die Lautstärke wird in den letzten 5 Sekunden reduziert. Der Timer zählt auch während einer Pause weiter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volume is reduced during the last 5 seconds. The timer continues counting while playback is paused."
          }
        }
      }
    },
    "Die Mac-Suche ist nicht verfügbar. Erlaube lokalen Netzwerkzugriff in den iOS-Einstellungen oder nutze die manuelle Adresse." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac discovery is unavailable. Allow local network access in iOS Settings or enter the address manually."
          }
        }
      }
    },
    "Die Quelle konnte auf dem Mac nicht vollständig verarbeitet werden (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source could not be fully processed on the Mac (%@)."
          }
        }
      }
    },
    "Die Quelle oder der Auftrag ist nicht mehr verfügbar. Aktualisiere die Liste." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source or job is no longer available. Refresh the list."
          }
        }
      }
    },
    "Die Quelle überschreitet die Verarbeitungsgrenzen des Companions." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source exceeds the Companion's processing limits."
          }
        }
      }
    },
    "Die Sprache der App kann jederzeit geändert werden. Die Änderung wird sofort übernommen." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change the app language at any time. The change takes effect immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar el idioma de la app en cualquier momento. El cambio se aplica de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue de l’app peut être modifiée à tout moment. Le changement est immédiat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiare la lingua dell’app in qualsiasi momento. La modifica è immediata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの言語はいつでも変更できます。変更はすぐに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 언어는 언제든지 변경할 수 있으며 즉시 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de app-taal op elk moment wijzigen. De wijziging wordt direct toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język aplikacji można zmienić w dowolnym momencie. Zmiana działa natychmiast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar o idioma do app a qualquer momento. A alteração é imediata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama dilini istediğiniz zaman değiştirebilirsiniz. Değişiklik hemen uygulanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时更改 App 语言，更改会立即生效。"
          }
        }
      }
    },
    "Die Startzuordnungen sind grobe Musikrichtungen. Du kannst das Genre eines Künstlers jederzeit ändern." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The initial assignments are broad music categories. You can change an artist's genre at any time."
          }
        }
      }
    },
    "Die TLS-Identität des Macs konnte nicht bestätigt werden. Prüfe Adresse, Zertifikat und Fingerabdruck auf dem Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac's TLS identity could not be verified. Check the address, certificate and fingerprint on the Mac."
          }
        }
      }
    },
    "Die Verarbeitung wurde abgebrochen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processing was cancelled."
          }
        }
      }
    },
    "Die Verbindung wird im Vordergrund automatisch geprüft. Im Hintergrund startet die App keine dauerhafte Netzwerksuche." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection is checked automatically while the app is in the foreground. The app does not run continuous network discovery in the background."
          }
        }
      }
    },
    "Die Vorschau konnte nicht geladen werden. Du kannst das Video direkt auf YouTube öffnen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The preview could not be loaded. You can open the video directly on YouTube."
          }
        }
      }
    },
    "Die YouTube-Antwort konnte nicht gelesen werden. Bitte versuche es erneut." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The YouTube response could not be read. Try again."
          }
        }
      }
    },
    "Die Ziel-Playlist wurde gelöscht. Wähle ein neues Importziel." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The destination playlist was deleted. Choose a new import destination."
          }
        }
      }
    },
    "Die Zuordnung gilt für vorhandene und künftig importierte Titel dieses Künstlers. Bei bekannten Namen wird das hinterlegte Genre vorgeschlagen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This assignment applies to existing songs and future imports by this artist. Known artists use their suggested genre."
          }
        }
      }
    },
    "Dies stellt das importierte Genre wieder her. Falls keines vorhanden ist, wird die automatische Künstlerzuordnung verwendet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores the imported genre. If none is available, the automatic artist assignment is used."
          }
        }
      }
    },
    "Diese Dateien haben identischen Inhalt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These files have identical content."
          }
