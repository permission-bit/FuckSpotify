    "Gib die private IPv4-Adresse deines Macs ein, z. B. https://192.168.1.23:8765. 127.0.0.1 zeigt auf das jeweilige Gerät." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Mac's private IPv4 address, for example https://192.168.1.23:8765. 127.0.0.1 refers to the device itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la dirección privada IPv4 de su Mac, por ejemplo https://192.168.1.23:8765. 127.0.0.1 se refiere al propio dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez l'adresse privée de votre Mac IPv4, par exemple https://192.168.1.23:8765. 127.0.0.1 se réfère à l'appareil lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci l'indirizzo privato del tuo Mac IPv4, ad esempio https://192.168.1.23:8765. 127.0.0.1 si riferisce al dispositivo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macのプライベートを入力する IPv4 例えば、アドレス https://192.168.1.23:8765」 127.0.0.1 装置そのものについてです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 개인 주소 IPv4을 입력하십시오, 예를 들어 https://192.168.1.23:8765. 127.0.0.1은 장치 자체를 나타냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer bijvoorbeeld het privé-adres IPv4 van uw Mac in, bijvoorbeeld https://192.168.1.23:8765. 127.0.0.1 verwijst naar het apparaat zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadź prywatny adres Mac IPv4, na przykład https://192.168.1.23:8765. 127.0.0.1 odnosi się do samego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre o endereço privado do seu Mac IPv4, por exemplo https://192.168.1.23:8765. 127.0.0.1 refere-se ao próprio dispositivo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'inizin özel IPv4 adresini girin, örneğin https://192.168.1.23:8765. 127.0.0.1 cihazın kendisine işaret eder."
          }
        },
        "zh-Hans" : {
