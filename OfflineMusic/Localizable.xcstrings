    "YouTube-Suche und Vorschau. Für einen Offline-Import wähle unter Importe deine freigegebenen Mac-Dateien." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search and preview on YouTube. To import music for offline playback, select your shared Mac files under Imports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca y preview en YouTube. Para importar música para reproducción offline, seleccione sus archivos de Mac compartidos en Importes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche et prévision sur YouTube. Pour importer de la musique pour la lecture hors ligne, sélectionnez vos fichiers Mac partagés sous Imports."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca e preview su YouTube. Per importare musica per la riproduzione offline, selezionare i file Mac condivisi nella sezione Import."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索・予測 YouTube。オフライン再生のための音楽をインポートするには、共有する Mac ファイルを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 및 사전 보기 YouTube.오프라인 재생을 위한 음악을 수입하려면 공유 Mac 파일을 수입 아래에서 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek en voorzien op YouTube. Als u muziek wilt importeren voor offline afspelen, selecteert u uw gedeelde Mac-bestanden onder Import."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj i przeglądaj na stronie YouTube. Aby zaimportować muzykę do odtwarzania offline, wybierz udostępnione pliki Mac pod pozycją Importy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa e previsão em YouTube. Para importar música para reprodução offline, selecione os arquivos do Mac compartilhados na seção Importar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama ve önizleme sayfasında YouTube. çevrimdışı oynatma için müzik ithal etmek için, Paylaşılan Mac dosyalarınızı İthalatlar bölümünde seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索和预览在 YouTube. 若要输入非线播放音乐,请在 Import 中选择共享 Mac 文件。"
          }
        }
      }
    },
