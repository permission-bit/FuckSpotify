    "%@ Prüfe auch die Auftragsliste; ein erneuter Versuch mit derselben Auswahl verwendet dieselbe Auftragsanfrage." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Also check the job list; retrying with the same selection reuses the same job request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Comprueba también la lista de tareas. Si vuelves a intentarlo con la misma selección, se reutilizará la misma solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vérifiez aussi la liste des tâches. Une nouvelle tentative avec la même sélection réutilise la même demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Controlla anche l’elenco delle attività. Riprovando con la stessa selezione, viene riutilizzata la stessa richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ジョブ一覧も確認してください。同じ選択内容で再試行すると、同じジョブリクエストが再利用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 작업 목록도 확인하세요. 같은 항목을 선택해 다시 시도하면 동일한 작업 요청을 재사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Controleer ook de takenlijst. Bij een nieuwe poging met dezelfde selectie wordt dezelfde aanvraag gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sprawdź też listę zadań. Ponowienie z tym samym wyborem wykorzysta to samo żądanie zadania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Confira também a lista de tarefas. Uma nova tentativa com a mesma seleção reutiliza a mesma solicitação."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Görev listesini de kontrol et. Aynı seçimle tekrar denersen aynı görev isteği kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请同时检查任务列表。使用相同的选项重试时会复用同一任务请求。"
          }
        }
      }
    },
