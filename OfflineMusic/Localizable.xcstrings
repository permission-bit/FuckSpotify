    "Die Lautstärke wird in den letzten 5 Sekunden reduziert. Der Timer zählt auch während einer Pause weiter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volume is reduced during the last 5 seconds. The timer continues counting while playback is paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volumen baja durante los últimos 5 segundos. El temporizador sigue avanzando aunque pauses la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume diminue pendant les 5 dernières secondes. Le minuteur continue même si la lecture est en pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il volume si abbassa negli ultimi 5 secondi. Il timer continua anche quando la riproduzione è in pausa."
          }
