    "Beim Kürzen des Originals entfernst du den markierten Bereich aus diesem Titel." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimming the original removes the marked section from this song."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al recortar el original, eliminarás el fragmento marcado de esta canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En raccourcissant l’original, vous supprimez le passage sélectionné de ce titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accorciando l’originale, rimuovi il segmento selezionato da questo brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の曲を短縮すると、選択した区間がこの曲から削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본을 자르면 이 곡에서 표시한 구간이 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je het origineel inkort, verwijder je het gemarkeerde fragment uit dit nummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycięcie oryginału usunie zaznaczony fragment utworu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao cortar o original, você remove o trecho marcado desta faixa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinali kısalttığında bu parçanın işaretli bölümünü kaldırırsın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裁剪原始歌曲会移除这首歌中标记的片段。"
          }
        }
      }
    },
    "Beim Kürzen des Originals entfernst du den Ton vor und nach der Auswahl aus diesem Titel." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimming the original removes the audio before and after the selection from this song."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al recortar el original, eliminarás el audio anterior y posterior a la selección de esta canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En raccourcissant l’original, vous supprimez le son avant et après la sélection de ce titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accorciando l’originale, rimuovi da questo brano l’audio prima e dopo la selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の曲を短縮すると、選択範囲の前後の音声がこの曲から削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본을 자르면 이 곡에서 선택 구간 앞뒤의 오디오가 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je het origineel inkort, verwijder je de audio vóór en na de selectie uit dit nummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycięcie oryginału usunie z utworu dźwięk przed zaznaczeniem i po nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao cortar o original, você remove desta faixa o áudio antes e depois da seleção."
          }
        },
        "tr" : {
          "stringUnit" : {
