    "Die Datei ist unvollständig oder beschädigt. Größe, Prüfsumme oder Audioformat stimmen nicht." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is incomplete or damaged. Its size, checksum or audio format does not match."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo está incompleto o dañado. El tamaño, la suma de comprobación o el formato de audio no coinciden."
