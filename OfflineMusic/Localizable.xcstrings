    "Stelle eigene oder entsprechend autorisierte Audiodateien auf dem Mac mit „add-file --device …“ für dieses iPhone bereit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Mac, use “add-file --device …” to share audio files you own or are authorized to use with this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu Mac, usa «add-file --device …» para compartir con este iPhone archivos de audio propios o autorizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le Mac, utilisez « add-file --device … » pour mettre à disposition de cet iPhone vos fichiers audio ou ceux que vous êtes autorisé à utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul Mac usa «add-file --device …» per rendere disponibili su questo iPhone i file audio che possiedi o sei autorizzato a usare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで「add-file --device …」を使って、自分のオーディオファイルや利用許可のあるファイルをこの iPhone に提供してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 ‘add-file --device …’를 사용해 소유하거나 권한이 있는 오디오 파일을 이 iPhone에 제공하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik op de Mac ‘add-file --device …’ om eigen of geautoriseerde audiobestanden voor deze iPhone beschikbaar te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij temu iPhone’owi własne lub autoryzowane pliki audio za pomocą polecenia „add-file --device …” na Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Mac, use “add-file --device …” para disponibilizar neste iPhone arquivos de áudio próprios ou autorizados."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’te “add-file --device …” komutuyla kendi ses dosyalarını veya kullanmaya yetkili olduğun dosyaları bu iPhone’a sun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Mac 上使用「add-file --device …」，将你拥有或获准使用的音频文件提供给此 iPhone。"
          }
        }
      }
    },
