    "Die ausgewählten Playlists und ihre Verknüpfungen werden entfernt. Songs und Audiodateien bleiben erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected playlists and their song links will be removed. Songs and audio files will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán las listas seleccionadas y sus vínculos. Las canciones y los archivos de audio se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists sélectionnées et leurs liens seront supprimés. Les titres et les fichiers audio seront conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
