    "Aktiviere YouTube Data API v3 für dein Google-Cloud-Projekt und beschränke den Schlüssel auf diese API. Er wird auf diesem Gerät gespeichert und nicht an deinen Mac gesendet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable YouTube Data API v3 for your Google Cloud project and restrict the key to this API. The key is stored on this device and is not sent to your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa YouTube Data API v3 en tu proyecto de Google Cloud y restringe la clave a esta API. Se guarda en este dispositivo y no se envía al Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez YouTube Data API v3 pour votre projet Google Cloud et limitez la clé à cette API. Elle est stockée sur cet appareil et n’est pas envoyée à votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva YouTube Data API v3 nel progetto Google Cloud e limita la chiave a questa API. La chiave viene salvata su questo dispositivo e non viene inviata al Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Cloud プロジェクトで YouTube Data API v3 を有効にし、キーの使用をこの API に制限してください。キーはこのデバイスに保存され、Mac には送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Cloud 프로젝트에서 YouTube Data API v3를 사용 설정하고 키 사용을 이 API로 제한하세요. 키는 이 기기에 저장되며 Mac으로 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel YouTube Data API v3 in voor je Google Cloud-project en beperk de sleutel tot deze API. De sleutel wordt op dit apparaat bewaard en gaat niet naar je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz YouTube Data API v3 w projekcie Google Cloud i ogranicz klucz do tego API. Klucz jest przechowywany na tym urządzeniu i nie jest wysyłany na Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a YouTube Data API v3 no projeto do Google Cloud e restrinja a chave a essa API. Ela fica armazenada neste dispositivo e não é enviada ao Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Cloud projen için YouTube Data API v3’ü etkinleştir ve anahtarı bu API ile sınırla. Anahtar bu aygıtta saklanır ve Mac’ine gönderilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Google Cloud 项目中启用 YouTube Data API v3，将密钥限制为仅可访问此 API。密钥保存在此设备上，不会发送到你的 Mac。"
          }
        }
      }
    },
    "Aktualisiere den Companion auf dem Mac und starte ihn neu." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update the Companion on the Mac and restart it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar el Companion en el Mac y reiniciarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour le Companion sur Mac et le redémarrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornare il Companion sul Mac e riavviarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac で Companion を更新し、再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 Companion을 업데이트하고 다시 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update de Companion op de Mac en herstart het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuj Companion na komputerze Mac i ponownie go uruchomić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Companion no Mac e reiniciar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'te Companion'u güncelleyin ve yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Mac 上更新 Companion 并重新启动它。"
          }
        }
      }
    },
    "Aktualisiert sich automatisch. Ein Titel zählt nach 30 gehörten Sekunden oder der Hälfte seiner Dauer als gespielt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates automatically. A song counts as played after 30 seconds of listening or half its duration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se actualiza automáticamente. Una canción cuenta como reproducida al escuchar 30 segundos o la mitad de su duración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise à jour automatique. Un titre compte comme écouté après 30 secondes d’écoute ou après la moitié de sa durée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aggiorna automaticamente. Un brano risulta riprodotto dopo 30 secondi di ascolto o dopo metà della sua durata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動で更新されます。曲を30秒または全体の半分まで聴くと、再生済みとしてカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 업데이트됩니다. 곡을 30초 또는 전체 길이의 절반만큼 들으면 재생한 것으로 집계됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch bijgewerkt. Een nummer telt als afgespeeld na 30 seconden luisteren of na de helft van de speelduur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje się automatycznie. Utwór jest zaliczany jako odtworzony po 30 sekundach słuchania lub po przesłuchaniu połowy jego długości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização é automática. Uma faixa conta como reproduzida após 30 segundos ou após a metade de sua duração."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik güncellenir. Bir parça 30 saniye ya da süresinin yarısı dinlendiğinde oynatılmış sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动更新。收听 30 秒或歌曲时长的一半后，即计为已播放。"
          }
        }
      }
    },
