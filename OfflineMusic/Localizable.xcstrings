    "Der SHA-256-Fingerabdruck muss aus 64 Hexadezimalzeichen bestehen. Übernimm ihn direkt vom Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SHA-256 fingerprint must contain 64 hexadecimal characters. Copy it directly from your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La huella SHA-256 debe tener 64 caracteres hexadecimales. Cópiala directamente del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’empreinte SHA-256 doit contenir 64 caractères hexadécimaux. Copiez-la directement depuis le Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impronta SHA-256 deve contenere 64 caratteri esadecimali. Copiala direttamente dal Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 フィンガープリントは64桁の16進数である必要があります。Mac から直接コピーしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 지문은 64자리 16진수여야 합니다. Mac에서 직접 복사하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De SHA-256-vingerafdruk moet uit 64 hexadecimale tekens bestaan. Kopieer deze rechtstreeks van de Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
