        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alemania y Inglés están totalmente traducidos. Otros idiomas se traducen parcialmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allemand et l'anglais sont entièrement traduits. d'autres langues sont partiellement traduites."
